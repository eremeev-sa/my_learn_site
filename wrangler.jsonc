{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dev-growth",
  "main": "server/worker.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": { "OWNER_USERNAME": "Eremeev-SA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dev-growth-db",
      "database_id": "5fe56632-5cc7-4d35-a76b-306a3717ee5d",
      "migrations_dir": "migrations"
    }
  ]
}
